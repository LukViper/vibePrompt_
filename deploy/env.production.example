# Copy to repo-root `.env.production` and fill in values.
# NEVER commit `.env.production` or real secrets.
#
#   cp deploy/env.production.example .env.production

# --- Required production identity ---
APP_ENV=production

# Generate strong unique values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-long-random-jwt-secret
CREDENTIALS_ENCRYPTION_KEY=replace-with-long-random-credentials-key
API_SECRET=replace-with-long-random-api-secret

# --- Persistence (container paths; compose mounts volume at /data) ---
DATABASE_PATH=/data/vibeprompt.db
KNOWLEDGE_UPLOAD_DIR=/data/knowledge/uploads
SKILLS_DIR=/data/skills

# --- Network / CORS ---
# Public HTTPS origin(s) of the web UI (comma-separated). Do not use localhost in real staging.
CORS_ORIGINS=https://app.example.com

# Published host ports (compose)
API_PUBLISH_PORT=8000
WEB_PUBLISH_PORT=8080

# --- Optional model providers (leave empty to run offline heuristics) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
QWEN_API_KEY=
FREE_TIER_ENABLED=false
CRITIC_ENABLED=true
REVIEW_INTENSITY=normal

# Knowledge Library admins (comma-separated emails) when free tier is on
ADMIN_EMAILS=

# Auth mode: auto | supabase | legacy
AUTH_MODE=auto
SUPABASE_URL=
SUPABASE_ANON_KEY=
