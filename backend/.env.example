# Primary chain (default order: gemini → openrouter → groq → offline heuristics)
# Override with PRIMARY_PROVIDER_ORDER=gemini,openrouter,groq

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (first failover)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=VibePrompt

# Groq (second failover + optional independent critic)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Failover / orchestration
PRIMARY_PROVIDER_ORDER=gemini,openrouter,groq
CRITIC_ENABLED=true
REVIEW_INTENSITY=normal
PROVIDER_TIMEOUT_SECONDS=30
FAILOVER_TOTAL_BUDGET_SECONDS=45
MAX_OUTPUT_TOKENS=2048
MAX_RETRIES=1

# Persistence
DATABASE_PATH=./data/vibeprompt.db

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: require a shared secret for API access (leave empty for local-only)
API_SECRET=
