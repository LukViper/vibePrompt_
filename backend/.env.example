# Primary chain (default order: gemini → openrouter → groq → offline heuristics)
# Override with PRIMARY_PROVIDER_ORDER=gemini,openrouter,groq

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (first failover)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=VibePrompt

# Groq (second failover + optional independent critic)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Platform-funded Qwen free tier (shared credentials — NOT per-user keys)
# ---------------------------------------------------------------------------
FREE_TIER_ENABLED=false
FREE_TIER_PROVIDER=qwen
FREE_TIER_MODEL=qwen3.5-flash
FREE_TIER_GENERATIONS=20
FREE_TIER_MAX_INPUT_TOKENS=8000
FREE_TIER_MAX_OUTPUT_TOKENS=2048
FREE_TIER_RATE_LIMIT_PER_MINUTE=10

# Central platform Qwen credentials via MuleRouter (sk-mr-… keys)
# Never expose to frontend.
QWEN_API_KEY=
QWEN_BASE_URL=https://api.mulerouter.ai/vendors/openai/v1

# Auth / BYOK encryption (change in production)
JWT_SECRET=dev-only-change-me-vibeprompt-jwt
JWT_EXPIRES_MINUTES=10080
CREDENTIALS_ENCRYPTION_KEY=dev-only-change-me-vibeprompt-creds
AUTH_REQUIRED_WHEN_FREE_TIER=true

# Failover / orchestration
PRIMARY_PROVIDER_ORDER=gemini,openrouter,groq
CRITIC_ENABLED=true
REVIEW_INTENSITY=normal
PROVIDER_TIMEOUT_SECONDS=30
FAILOVER_TOTAL_BUDGET_SECONDS=45
MAX_OUTPUT_TOKENS=2048
MAX_RETRIES=1
TEMPERATURE_CONVERSATIONAL=0.6
TEMPERATURE_BRAINSTORMING=0.8
TEMPERATURE_GRILL_REVIEW=0.3
HISTORY_MAX_MESSAGES=12
HISTORY_MAX_CHARS=2000

# Persistence
# Local/dev paths. For containers use /data/... (see deploy/env.production.example).
DATABASE_PATH=./data/vibeprompt.db
KNOWLEDGE_UPLOAD_DIR=./data/knowledge/uploads
SKILLS_DIR=./data/skills
KNOWLEDGE_MAX_UPLOAD_BYTES=41943040

# Knowledge Library admins (comma-separated). Required when FREE_TIER_ENABLED=true.
# When free tier is off and this is empty, any authenticated user may administer locally.
ADMIN_EMAILS=

# Server
HOST=0.0.0.0
PORT=8000
# Dev UI origin. Production/staging: set to your HTTPS frontend origin(s).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production (ENV is accepted as an alias for APP_ENV)
# production refuses insecure JWT/CREDENTIALS defaults and requires API_SECRET
APP_ENV=development

# Shared API secret (X-API-Secret). Optional in development; REQUIRED in production.
API_SECRET=

# ---------------------------------------------------------------------------
# Staging / production packaging
# ---------------------------------------------------------------------------
# Use deploy/env.production.example → .env.production (never commit real secrets).
# Compose: podman compose --env-file .env.production up -d --build
# Docs: docs/DEPLOYMENT_AND_RECOVERY.md

