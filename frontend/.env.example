# Frontend env for local Vite and Vercel builds.
# On Vercel, set these in Project Settings → Environment Variables.

# Public API base (include /api suffix). Leave empty to use same-origin "/api"
# (dev proxy or a reverse proxy). For split deploy, point at your API host:
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=

# Do NOT set a static API secret in the SPA. The client mints a short-lived
# guest JWT via POST /api/auth/guest (or uses a logged-in user Bearer token).
# Server-side API_SECRET remains for ops/curl only — never bundle it here.

# Supabase Auth (browser-safe anon / publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alias accepted by the client:
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Sign-In (must match backend GOOGLE_OAUTH_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
