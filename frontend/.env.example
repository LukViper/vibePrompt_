# Frontend env for local Vite and Vercel builds.
# On Vercel, set these in Project Settings → Environment Variables.

# Public API base (include /api suffix). Leave empty to use same-origin "/api"
# (dev proxy or a reverse proxy). For split deploy, point at your API host:
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=

# Optional shared gate matching backend API_SECRET (X-API-Secret).
# Required when the API runs with APP_ENV=production.
# Prefer injecting via Vercel env vars — never commit real secrets.
VITE_API_SECRET=

# Supabase Auth (browser-safe anon / publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alias accepted by the client:
# VITE_SUPABASE_PUBLISHABLE_KEY=
